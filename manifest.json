{
  "manifest_version": 3,
  "name": "WASM-Sentry",
  "version": "0.1.0",
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/injector.js"],
    "run_at": "document_start"
  }]
}